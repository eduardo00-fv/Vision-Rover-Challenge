DEF ROVER_10 Robot {
  translation 0.08 0.35 0.0525
  rotation 0 0 1 0
  name "rover_10"
  controller "rover_agent"
  children [
    Shape { appearance Appearance { material Material { diffuseColor 0.08 0.08 0.08 } } geometry Box { size 0.12 0.10 0.055 } }
    Transform { translation 0 0 0.031 children [ Shape { appearance Appearance { texture ImageTexture { url [ "../assets/aruco/id10.png" ] } } geometry Box { size 0.05 0.05 0.003 } } ] }
    Transform { translation 0.068 0.032 0.015 children [ Shape { appearance Appearance { material Material { diffuseColor 0.75 0.75 0.75 } } geometry Box { size 0.018 0.012 0.02 } } ] }
    Transform { translation 0.068 -0.032 0.015 children [ Shape { appearance Appearance { material Material { diffuseColor 0.75 0.75 0.75 } } geometry Box { size 0.018 0.012 0.02 } } ] }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0.044 -0.0275 }
      device [ RotationalMotor { name "left_wheel_motor" maxTorque 0.5 maxVelocity 25 } ]
      endPoint Solid {
        name "rover10_left_wheel"
        translation 0 0.044 -0.0275
        rotation 1 0 0 -1.5708
        contactMaterial "rover_wheel"
        children [ Shape { appearance Appearance { material Material { diffuseColor 0.12 0.12 0.12 } } geometry Cylinder { radius 0.025 height 0.014 } } ]
        boundingObject Cylinder { radius 0.025 height 0.014 }
        physics Physics { density -1 mass 0.04 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 -0.044 -0.0275 }
      device [ RotationalMotor { name "right_wheel_motor" maxTorque 0.5 maxVelocity 25 } ]
      endPoint Solid {
        name "rover10_right_wheel"
        translation 0 -0.044 -0.0275
        rotation 1 0 0 -1.5708
        contactMaterial "rover_wheel"
        children [ Shape { appearance Appearance { material Material { diffuseColor 0.12 0.12 0.12 } } geometry Cylinder { radius 0.025 height 0.014 } } ]
        boundingObject Cylinder { radius 0.025 height 0.014 }
        physics Physics { density -1 mass 0.04 }
      }
    }
  ]
  # Dos castors de baja fricción, como el AttaBot físico: estabilizan el
  # chasis sin convertir el cuerpo en una tercera rueda motriz.
  boundingObject Group {
    children [
      Box { size 0.12 0.10 0.055 }
      Transform { translation 0.04 0 -0.044 children [ Sphere { radius 0.008 } ] }
      Transform { translation -0.04 0 -0.044 children [ Sphere { radius 0.008 } ] }
    ]
  }
  contactMaterial "rover_body"
  physics Physics { density -1 mass 0.27 }
}
