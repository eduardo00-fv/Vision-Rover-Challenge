  physics Physics { density -1 mass 0.27 }
}
DEF VISION_SUPERVISOR Robot {
  supervisor TRUE
  controller "vision_supervisor"
  name "vision_supervisor"
  children [
    Transform {
      translation 0.43 0.43 1.35
      # Camera mira por +X en su eje local. Rotación +90° sobre Y la orienta
      # hacia −Z, perpendicular a la cancha ENU.
      rotation 0 1 0 1.5708
      children [ Camera { name "overhead_camera" width 1280 height 1280 fieldOfView 0.85 } ]
    }
  ]
}
