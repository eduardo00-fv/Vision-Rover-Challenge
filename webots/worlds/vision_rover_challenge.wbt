#VRML_SIM R2025a utf8

WorldInfo {
  basicTimeStep 32
  contactProperties [
    ContactProperties { material1 "rover_body" coulombFriction [ 0.05 ] }
    ContactProperties { material1 "rover_wheel" coulombFriction [ 3 ] }
  ]
}
# Vista cenital: el eje óptico local de Viewpoint se orienta hacia +Z, por lo
# que se invierte para mirar desde arriba a la cancha (−Z).
Viewpoint { orientation 1 0 0 3.14159 position 0.43 0.43 1.35 }
Background { skyColor [ 0.20 0.32 0.46 ] }
DirectionalLight { direction 0.2 0.1 -1 intensity 2.5 castShadows TRUE }

DEF BOARD Solid {
  translation 0.43 0.43 -0.012
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.92 0.92 0.88 } } geometry Box { size 1 1 0.024 } } ]
  boundingObject Box { size 1 1 0.024 }
  name "physical_board_1000mm"
}
DEF CORNER_0 Solid {
  translation 0 0 0.002
  children [ Shape { appearance Appearance { texture ImageTexture { url [ "../assets/aruco/id0.png" ] } } geometry Box { size 0.14 0.14 0.004 } } ]
